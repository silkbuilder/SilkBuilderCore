	</sqlSelect>

	<sqlSelect name="systemDbController" silkDatabaseID="2" >
		<![CDATA[
			select
				sy.silkDatabaseID,
				coalesce(sy.testController,db.databaseController) as databaseController
			from silkSystem sy
			join silkDatabase db on sy.silkDatabaseID = db.silkDatabaseID
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

	<sqlSelect name="systemDbController" silkDatabaseID="1" >
		<![CDATA[
			select
				sy.silkDatabaseID,
				isNull(sy.testController,db.databaseController) as databaseController
			from silkSystem sy
			join silkDatabase db on sy.silkDatabaseID = db.silkDatabaseID
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

	<sqlSelect name="systemDbController" silkDatabaseID="3" >
		<![CDATA[
			select
				sy.silkDatabaseID,
				coalesce(sy.testController,db.databaseController) as databaseController
			from silkSystem sy
			join silkDatabase db on sy.silkDatabaseID = db.silkDatabaseID
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

	<sqlSelect name="systemDbController" silkDatabaseID="4" >
		<![CDATA[
			select
				sy.silkDatabaseID,
				nvl(sy.testController,db.databaseController) as databaseController
			from silkSystem sy
			join silkDatabase db on sy.silkDatabaseID = db.silkDatabaseID
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

