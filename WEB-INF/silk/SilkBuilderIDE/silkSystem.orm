<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE ormObject>
<orm >

	<table name="silkSystem" >
		<column name="silkSystemID" type="I" pk="1" />
		<column name="silkSystemUUID" type="S" />
		<column name="systemName" type="S" />
		<column name="theme" type="S" />
		<column name="langList" type="S" />
		<column name="menuLink" type="S" />
		<column name="loginLink" type="S" />
		<column name="databaseList" type="S" />
		<column name="silkDatabaseID" type="I" />
		<column name="testController" type="S" />
		<column name="testdb" type="S" />
		<column name="testdb1" type="S" />
		<column name="testdb2" type="S" />
		<column name="testdb3" type="S" />
		<column name="testdb4" type="S" />
		<column name="systemStatus" type="I" />
		<column name="creationDate" type="D" />
		<column name="operationDate" type="D" />
		<column name="operationUser" type="I" secure="1" />
		<column name="operationAction" type="S" />
		<column name="silkTargetID" type="I" secure="1" />
	</table>

	<schema silkDatabaseID="2" />
	<schema silkDatabaseID="1" />
	<schema silkDatabaseID="3" />
	<schema silkDatabaseID="4" />

	<sqlSelect silkDatabaseID="2" >
		<![CDATA[
			select
				*
			from silkSystem
			order by systemName
		]]>
	</sqlSelect>

	<sqlSelect silkDatabaseID="1" >
		<![CDATA[
			select
				*
			from silkSystem
