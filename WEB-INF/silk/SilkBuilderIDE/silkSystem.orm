	<sqlSelect name="systemList" silkDatabaseID="2" >
		<![CDATA[
			select
				silkSystemID,
				systemName,
				menuLink,
				creationDate
			from silkSystem sy
			where systemStatus = 0
			order by systemName
		]]>
	</sqlSelect>

	<sqlSelect name="systemList" silkDatabaseID="1" >
