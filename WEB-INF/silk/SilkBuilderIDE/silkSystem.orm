	<sqlSelect name="sync-system" silkDatabaseID="2" >
		<![CDATA[
			select
				sy.systemName,
				sy.theme,
				tr.defaultLangID as langID,
				sy.menuLink,
				sy.loginLink
			from silkSystem sy
			join silkTarget tr on sy.silkSystemID = tr.silkSystemID
				and tr.silkTargetID = $P{silkTargetID}
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

	<sqlSelect name="sync-system" silkDatabaseID="1" >
		<![CDATA[
			select
				sy.systemName,
				sy.theme,
				tr.defaultLangID as langID,
				sy.menuLink,
				sy.loginLink
			from silkSystem sy
			join silkTarget tr on sy.silkSystemID = tr.silkSystemID
				and tr.silkTargetID = $P{silkTargetID}
			where sy.silkSystemID = $P{silkSystemID}
		]]>
	</sqlSelect>

	<sqlSelect name="sync-system" silkDatabaseID="3" >
