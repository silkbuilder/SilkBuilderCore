	<sqlSelect name="tagSystemExport" silkDatabaseID="2" >
		<![CDATA[
			select
				silkTagID as exportTagID,
				silkSystemID as exportSystemID,
				parentID as exportParentID,
				tagLevel,
				tagName,
				tagType,
				tagIntValue,
				content,
				contentType,
				folderOnly,
				position
			from silkTag
			where silkSystemID = $P{silkSystemID}
			order by tagLevel
		]]>
	</sqlSelect>

