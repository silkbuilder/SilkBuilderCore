<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE ormObject>
<orm >

	<table name="silkTag" >
		<column name="silkTagID" type="I" pk="1" />
		<column name="silkSystemID" type="I" secure="1" />
		<column name="parentID" type="I" secure="1" parent="1" />
		<column name="tagLevel" type="I" level="1" />
		<column name="tagName" type="S" />
		<column name="tagType" type="I" />
		<column name="tagIntValue" type="I" />
		<column name="content" type="S" translation="1" />
		<column name="contentType" type="I" />
		<column name="folderOnly" type="I" />
		<column name="position" type="I" order="1" />
		<column name="syncDate" type="D" />
		<column name="operationAction" type="S" opAction="1" />
		<column name="operationDate" type="D" opDate="1" />
		<column name="operationUser" type="I" secure="1" opUser="1" />
		<column name="silkTargetID" type="I" secure="1" />
	</table>

	<schema silkDatabaseID="2" />
	<schema silkDatabaseID="1" />
	<schema silkDatabaseID="3" />
	<schema silkDatabaseID="4" />

	<sqlSelect name="silkTags" silkDatabaseID="2" >
		<![CDATA[
			select
				0 as silkTagID,
				0 parentID,
				0 as tagLevel,
				'SilkBuilder Tags <i class="fas fa-tags" aria-hidden="true"></i>&nbsp;' as tagName,
				'' as content,
				0 as contentType,
				1 as folderOnly,
				0 as position,
				'' as action
			union	
			select
				pt.silkTagID,
				pt.parentID,
				pt.tagLevel,
				pt.tagName,
				$T{pt.content} as content,
				pt.contentType,
				pt.folderOnly,
				pt.position,
				'&nbsp;<i class="fa fa-bars" aria-hidden="true"></i>' as action
			from silkTag pt
			where pt.silkSystemID = 0
			and pt.tagType=0
			order by tagLevel, parentID, position, tagName
		]]>
	</sqlSelect>

