	<sqlSelect name="sync-tags" silkDatabaseID="2" >
		<![CDATA[
			select
				case when tg.tagType=1 then tp.tagName else NULL end as groupName,
				tg.tagName,
				tg.tagType,
				tg.tagIntValue,
				tg.content,
				tg.position
			from silkTag tg
			left join silkTag tp on tg.parentID = tp.silkTagID
			left join silkTarget tr on tr.silkTargetID = $P{silkTargetID}
			where coalesce(tg.content,'') <>''
			and tg.silkSystemID in ($P{silkSystemID},0)
			and tg.operationDate>coalesce(tr.syncDate,2000-01-01)
			order by tagType, groupName, position, tagName
		]]>
	</sqlSelect>

	<sqlSelect name="sync-tags" silkDatabaseID="1" >
		<![CDATA[
			select
				case when tg.tagType=1 then tp.tagName else NULL end as groupName,
				tg.tagName,
				tg.tagType,
				tg.tagIntValue,
				tg.content,
				tg.position
			from silkTag tg
			left join silkTag tp on tg.parentID = tp.silkTagID
			left join silkTarget tr on tr.silkTargetID = $P{silkTargetID}
			where coalesce(tg.content,'') <>''
			and tg.silkSystemID in ($P{silkSystemID},0)
			and tg.operationDate>coalesce(tr.syncDate,2000-01-01)
			order by tagType, groupName, position, tagName
		]]>
	</sqlSelect>

	<sqlSelect name="sync-tags" silkDatabaseID="3" >
		<![CDATA[
			select
				case when tg.tagType=1 then tp.tagName else NULL end as groupName,
				tg.tagName,
				tg.tagType,
				tg.tagIntValue,
				tg.content,
				tg.position
			from silkTag tg
			left join silkTag tp on tg.parentID = tp.silkTagID
			left join silkTarget tr on tr.silkTargetID = $P{silkTargetID}
			where coalesce(tg.content,'') <>''
			and tg.silkSystemID in ($P{silkSystemID},0)
			and tg.operationDate>coalesce(tr.syncDate,'2000-01-01')
			order by tagType, groupName, position, tagName
		]]>
	</sqlSelect>

	<sqlSelect name="sync-tags" silkDatabaseID="4" >
		<![CDATA[
			select
				case when tg.tagType=1 then tp.tagName else NULL end as groupName,
				tg.tagName,
				tg.tagType,
				tg.tagIntValue,
				tg.content,
				tg.position
			from silkTag tg
			left join silkTag tp on tg.parentID = tp.silkTagID
			left join silkTarget tr on tr.silkTargetID = $P{silkTargetID}
			where DBMS_LOB.COMPARE(nvl(tg.content,TO_CLOB('')), TO_CLOB('')) <> 0
			and tg.silkSystemID in ($P{silkSystemID},0)
			and tg.operationDate>nvl(tr.syncDate,'2000-01-01')
			order by tagType, groupName, position, tagName
		]]>
	</sqlSelect>

