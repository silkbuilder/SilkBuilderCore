			union
			select distinct
				tg.silkTagID as exportTagID,
				tg.silkSystemID as exportSystemID,
				tg.parentID as exportParentID,
				tg.tagLevel,
				tg.tagName,
				tg.tagType,
				tg.tagIntValue,
				tg.content,
				tg.contentType,
				tg.folderOnly,
				tg.position
			from silkTag tg
			join silkTag ch1 on tg.silkTagID = ch1.parentID
			where tg.silkSystemID = $P{silkSystemID}
			and ch1.tagName in ($V{tagList})
			union
			select distinct
