	<sqlSelect name="systemExport" silkDatabaseID="2" >
		<![CDATA[
			select
				silkProjectID as exportProjectID,
				projectUUID,
				silkSystemID as exportSystemID,
				parentID as exportParentID,
				projectLevel,
				projectName,
				nodeType,
				content,
				lastSyncID,
				status
			from silkProject
			where silkSystemID = $P{silkSystemID}
			and status = 0
			order by projectLevel
		]]>
	</sqlSelect>

