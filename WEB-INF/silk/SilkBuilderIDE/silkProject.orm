					when readOnly like '%'||pr.nodeType||'%' then 0
					else -1
				end as rights,
				pr.nodeType,
				pr.silkSystemID
			from silkDevRole rl
			join silkProject pr on pr.silkProjectID = $P{silkProjectID}
			where $P{roleList} like '%,'||rl.silkDevRoleID||',%')
		]]>
	</sqlSelect>

	<sqlSelect name="content" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.silkSystemID,
				ps.systemName,
				ps.silkDatabaseID,
				db.databaseName,
				pj.projectLevel,
				pj.projectName,
				pj.operationDate,
				coalesce(pj.lastSyncID,0) as lastSyncID,
				ch.commitDate,
				ch.commitUser,
				case when pj.projectLevel=4 then p3.projectUUID else p2.projectUUID end as resourceProjectUUID,
				case when pj.projectLevel=4 then p3.projectName else p2.projectName end as resourceProjectName,
				coalesce(pj.content, pn.template) as content,
				pn.nodeType,
				concat(
					'/',
					case when pj.projectLevel=4 then p3.projectName else '' end,
					'/',
					p2.projectName,
					'/',
					p1.projectName,
					'/',
					pj.projectName
				) as projectPath
				
			from silkProject pj
			
			join silkNode pn on pj.nodeType=pn.nodeType
			join silkSystem ps on pj.silkSystemID=ps.silkSystemID
			left join silkDatabase db on ps.silkDatabaseID=db.silkDatabaseID
			
			left join silkCodeHistory ch on pj.lastSyncID = ch.silkCodeHistoryID
				
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
			and p1.status=0
			and p2.status=0
			and p3.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="content" silkDatabaseID="1" >
		<![CDATA[
			select
				pj.silkSystemID,
				ps.systemName,
				ps.silkDatabaseID,
				db.databaseName,
				pj.projectLevel,
				pj.projectName,
				pj.operationDate,
				isNull(pj.lastSyncID,0) as lastSyncID,
				ch.commitDate,
				ch.commitUser,
				case when pj.projectLevel=4 then p3.projectUUID else p2.projectUUID end as resourceProjectUUID,
				case when pj.projectLevel=4 then p3.projectName else p2.projectName end as resourceProjectName,
				isNull(pj.content, pn.template) as content,
				pn.nodeType,
				concat(
					'/',
					case when pj.projectLevel=4 then p3.projectName else '' end,
					'/',
					p2.projectName,
					'/',
					p1.projectName,
					'/',
					pj.projectName
				) as projectPath
				
			from silkProject pj
			
			join silkNode pn on pj.nodeType=pn.nodeType
			join silkSystem ps on pj.silkSystemID=ps.silkSystemID
			left join silkDatabase db on ps.silkDatabaseID=db.silkDatabaseID
			
			left join silkCodeHistory ch on pj.lastSyncID = ch.silkCodeHistoryID
			
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
			and p1.status=0
			and p2.status=0
			and p3.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="content" silkDatabaseID="3" >
		<![CDATA[
			select
				pj.silkSystemID,
				ps.systemName,
				ps.silkDatabaseID,
				db.databaseName,
				pj.projectLevel,
				pj.projectName,
				pj.operationDate,
				coalesce(pj.lastSyncID,0) as lastSyncID,
				ch.commitDate,
				ch.commitUser,
				case when pj.projectLevel=4 then p3.projectUUID else p2.projectUUID end as resourceProjectUUID,
				case when pj.projectLevel=4 then p3.projectName else p2.projectName end as resourceProjectName,
				coalesce(pj.content, pn.template) as content,
				pn.nodeType,
				concat(
					'/',
					case when pj.projectLevel=4 then p3.projectName else '' end,
					'/',
					p2.projectName,
					'/',
					p1.projectName,
					'/',
					pj.projectName
				) as projectPath
				
			from silkProject pj
			
			join silkNode pn on pj.nodeType=pn.nodeType
			join silkSystem ps on pj.silkSystemID=ps.silkSystemID
			left join silkDatabase db on ps.silkDatabaseID=db.silkDatabaseID
			
			left join silkCodeHistory ch on pj.lastSyncID = ch.silkCodeHistoryID
			
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
			and p1.status=0
			and p2.status=0
			and p3.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="content" silkDatabaseID="4" >
		<![CDATA[
			select
				pj.silkSystemID,
				ps.systemName,
				ps.silkDatabaseID,
				db.databaseName,
				pj.projectLevel,
				pj.projectName,
				pj.operationDate,
				nvl(pj.lastSyncID,0) as lastSyncID,
				ch.commitDate,
				ch.commitUser,
				case when pj.projectLevel=4 then p3.projectUUID else p2.projectUUID end as resourceProjectUUID,
				case when pj.projectLevel=4 then p3.projectName else p2.projectName end as resourceProjectName,
				nvl(pj.content, pn.template) as content,
				pn.nodeType,
				'/'||
					case when pj.projectLevel=4 then p3.projectName else '' end||
					'/'||
					p2.projectName||
					'/'||
					p1.projectName||
					'/'||
					pj.projectName
				as projectPath
				
			from silkProject pj
			
			join silkNode pn on pj.nodeType=pn.nodeType
			join silkSystem ps on pj.silkSystemID=ps.silkSystemID
			left join silkDatabase db on ps.silkDatabaseID=db.silkDatabaseID
			
			left join silkCodeHistory ch on pj.lastSyncID = ch.silkCodeHistoryID
			
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
			and p1.status=0
			and p2.status=0
			and p3.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="sourceData" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.silkSystemID,
				pj.projectUUID as resourceUUID,
				case
					when pj.projectLevel=1 then pj.projectUUID
					when pj.projectLevel=2 then p1.projectUUID 
					when pj.projectLevel=3 then p2.projectUUID 
					else p3.projectUUID 
				end as projectUUID,
				case
					when pj.projectLevel=1 then pj.silkProjectID
					when pj.projectLevel=2 then p1.silkProjectID 
					when pj.projectLevel=3 then p2.silkProjectID 
					else p3.silkProjectID 
				end as projectID,
				replace(case when pj.projectLevel=3 then p1.projectName else p2.projectName end,' ','_') as parentName,
				replace(pj.projectName,' ','') as sourceName,
				p1.projectName as moduleParent,
				coalesce(pj.content, pn.template) as content,
				pn.saveMode,
				pj.projectLevel,
				'' as treePath,
				pn.extension,
				pn.nodeType
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="sourceData" silkDatabaseID="1" >
		<![CDATA[
			select
				pj.silkSystemID,
				pj.projectUUID as resourceUUID,
				case
					when pj.projectLevel=1 then pj.projectUUID
					when pj.projectLevel=2 then p1.projectUUID 
					when pj.projectLevel=3 then p2.projectUUID 
					else p3.projectUUID 
				end as projectUUID,
				case
					when pj.projectLevel=1 then pj.silkProjectID
					when pj.projectLevel=2 then p1.silkProjectID 
					when pj.projectLevel=3 then p2.silkProjectID 
					else p3.silkProjectID 
				end as projectID,
				replace(case when pj.projectLevel=3 then p1.projectName else p2.projectName end,' ','_') as parentName,
				replace(pj.projectName,' ','') as sourceName,
				p1.projectName as moduleParent,
				coalesce(pj.content, pn.template) as content,
				pn.saveMode,
				pj.projectLevel,
				'' as treePath,
				pn.extension,
				pn.nodeType
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="sourceData" silkDatabaseID="3" >
		<![CDATA[
			select
				pj.silkSystemID,
				pj.projectUUID,
				case
					when pj.projectLevel=1 then pj.projectUUID
					when pj.projectLevel=2 then p1.projectUUID 
					when pj.projectLevel=3 then p2.projectUUID 
					else p3.projectUUID 
				end as projectUUID,
				case
					when pj.projectLevel=1 then pj.silkProjectID
					when pj.projectLevel=2 then p1.silkProjectID 
					when pj.projectLevel=3 then p2.silkProjectID 
					else p3.silkProjectID 
				end as projectID,
				replace(case when pj.projectLevel=3 then p1.projectName else p2.projectName end,' ','_') as parentName,
				replace(pj.projectName,' ','') as sourceName,
				p1.projectName as moduleParent,
				coalesce(pj.content, pn.template) as content,
				pn.saveMode,
				pj.projectLevel,
				'' as treePath,
				pn.extension,
				pn.nodeType
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="sourceData" silkDatabaseID="4" >
		<![CDATA[
			select
				pj.silkSystemID,
				pj.projectUUID,
				case
					when pj.projectLevel=1 then pj.projectUUID
					when pj.projectLevel=2 then p1.projectUUID 
					when pj.projectLevel=3 then p2.projectUUID 
					else p3.projectUUID 
				end as projectUUID,
				case
					when pj.projectLevel=1 then pj.silkProjectID
					when pj.projectLevel=2 then p1.silkProjectID 
					when pj.projectLevel=3 then p2.silkProjectID 
					else p3.silkProjectID 
				end as projectID,
				replace(case when pj.projectLevel=3 then p1.projectName else p2.projectName end,' ','_') as parentName,
				replace(pj.projectName,' ','') as sourceName,
				p1.projectName as moduleParent,
				coalesce(pj.content, pn.template) as content,
				pn.saveMode,
				pj.projectLevel,
				'' as treePath,
				pn.extension,
				pn.nodeType
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.silkProjectID = $P{silkProjectID}
			and pj.status=0
		]]>
	</sqlSelect>

	<sqlSelect name="ormList" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.silkProjectID,
				concat(
					p2.projectUUID,
					'/',
					replace(pj.projectName,' ','')
				) as ormPath,
				concat('/',
					p2.projectName,'/',
					p1.projectName,'/',
					pj.projectName
				) as projectPath
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and coalesce(pj.content,'')<>''
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			order by ormPath
		]]>
	</sqlSelect>

	<sqlSelect name="ormList" silkDatabaseID="1" >
		<![CDATA[
			select
				pj.silkProjectID,
				concat(
					p2.projectUUID,
					'/',
					replace(pj.projectName,' ','')
				) as ormPath,
				concat('/',
					p2.projectName,'/',
					p1.projectName,'/',
					pj.projectName
				) as projectPath
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and isNull(pj.content,'')<>''
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			order by ormPath
		]]>
	</sqlSelect>

	<sqlSelect name="ormList" silkDatabaseID="3" >
		<![CDATA[
			select
				pj.silkProjectID,
				concat(
					p2.projectUUID,
					'/',
					replace(pj.projectName,' ','')
				) as ormPath,
				concat('/',
					p2.projectName,'/',
					p1.projectName,'/',
					pj.projectName
				) as projectPath
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and coalesce(pj.content,'')<>''
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			order by ormPath
		]]>
	</sqlSelect>

	<sqlSelect name="ormList" silkDatabaseID="4" >
		<![CDATA[
			select
				pj.silkProjectID,
				p2.projectUUID||'/'||replace(pj.projectName,' ','') as ormPath,
				'/'||p2.projectName||'/'||p1.projectName||'/'||pj.projectName as projectPath
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and nvl(dbms_lob.getlength(pj.content),0) <> 0
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			order by ormPath
		]]>
	</sqlSelect>

	<sqlSelect name="ormContent" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.silkProjectID,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and coalesce(pj.content,'')<>''
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and concat(
					p2.projectUUID,
					'/',
					replace(pj.projectName,' ','')
				) = $P{ormPath}
		]]>
	</sqlSelect>

	<sqlSelect name="ormContent" silkDatabaseID="1" >
		<![CDATA[
