			end;
		]]>
	</sqlOperation>

	<sqlOperation silkDatabaseID="2" name="updateUUID" >
		<![CDATA[
			update silkProject set
				content = replace(content, $P{oldUUID}, $P{newUUID})
			where silkSystemID = $P{silkSystemID}
		]]>
	</sqlOperation>

	<sqlOperation silkDatabaseID="1" name="updateUUID" >
