	<sqlOperation silkDatabaseID="2" name="updateContent" >
		<![CDATA[
			insert into silkCodeHistory (silkProjectID, content, commitFlag, operationDate, operationUser)
			select
				silkProjectID,
				content,
				0,
				operationDate,
				operationUser
			from silkProject
			where silkProjectID = $P{silkProjectID}
		]]>
	</sqlOperation>

	<sqlOperation silkDatabaseID="1" name="updateContent" >
