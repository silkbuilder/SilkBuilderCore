			and pj.status=0
			and concat(
					p2.projectUUID,
					'/',
					replace(pj.projectName,' ','')
				) = $P{ormPath}
		]]>
	</sqlSelect>

	<sqlSelect name="ormContent" silkDatabaseID="4" >
		<![CDATA[
			select
				pj.silkProjectID,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.nodeType in ('ORM','ORMF')
			and coalesce(pj.content,'')<>''
			and pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and p2.projectUUID||'/'||replace(pj.projectName,' ','') = $P{ormPath}
		]]>
	</sqlSelect>

	<sqlSelect name="dbObjectList" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.projectName,
				pj.nodeType,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			where pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and pj.nodeType in ('ORM','DBPR','DBTR','DBVW')
			and pj.status=0
			and position(
					concat('/',$P{silkProjectID},'/') in
					concat('/',
						p3.silkProjectID,'/',
						p2.silkProjectID,'/',
						p1.silkProjectID,'/',
						pj.silkProjectID,'/'
					)
				) > 0
		]]>
	</sqlSelect>

	<sqlSelect name="dbObjectList" silkDatabaseID="1" >
		<![CDATA[
			select
				pj.projectName,
				pj.nodeType,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			where pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and pj.nodeType in ('ORM','DBPR','DBTR','DBVW')
			and pj.status=0
			and charindex(
					concat('/',$P{silkProjectID},'/'),
					concat('/',
						p3.silkProjectID,'/',
						p2.silkProjectID,'/',
						p1.silkProjectID,'/',
						pj.silkProjectID,'/'
					)
				) > 0
		]]>
	</sqlSelect>

	<sqlSelect name="dbObjectList" silkDatabaseID="3" >
		<![CDATA[
			select
				pj.projectName,
				pj.nodeType,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			where pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and pj.nodeType in ('ORM','DBPR','DBTR','DBVW')
			and pj.status=0
			and position(
					concat('/',$P{silkProjectID},'/') in
					concat('/',
						p3.silkProjectID,'/',
						p2.silkProjectID,'/',
						p1.silkProjectID,'/',
						pj.silkProjectID,'/'
					)
				) > 0
		]]>
	</sqlSelect>

	<sqlSelect name="dbObjectList" silkDatabaseID="4" >
		<![CDATA[
			select
				pj.projectName,
				pj.nodeType,
				pj.content
			from silkProject pj
			left join silkProject p1 on pj.parentID=p1.silkProjectID
			left join silkProject p2 on p1.parentID=p2.silkProjectID
			left join silkProject p3 on p2.parentID=p3.silkProjectID
			where pj.silkSystemID = $P{silkSystemID}
			and pj.status=0
			and pj.nodeType in ('ORM','DBPR','DBTR','DBVW')
			and pj.status=0
			and instr(
					'/' || $P{silkProjectID} || '/',
					'/' ||
						p3.silkProjectID || '/' ||
						p2.silkProjectID || '/' ||
						p1.silkProjectID || '/' ||
						pj.silkProjectID || '/'
					
				) > 0
		]]>
	</sqlSelect>

	<sqlSelect name="sync-files" silkDatabaseID="2" >
		<![CDATA[
			select
				pj1.silkProjectID,
				replace(
					concat(
						'/',
						case
							when pj1.projectLevel=3
							then pj3.projectUUID
							else concat(pj4.projectUUID,'/',pj3.projectName)
						end,'/',
						case
							when pj1.nodeType='ORM' or pj1.nodeType='ORMF'
							then ''
							else concat(pj2.projectName,'/')
						end
					),
					'//',
					'/'
				) as filePath,
				concat(pj1.projectName,pn.extension) as fileName,
				
				case
					when pj1.projectLevel=3
					then pj3.silkProjectID
					else pj4.silkProjectID
				end as cleanID,
				
				case
					when pj1.projectLevel=3
					then pj3.projectUUID
					else pj4.projectUUID
				end as cleanUUID,
			
				case
					when pj1.nodeType='MOD' or pj1.nodeType='ORMF'
					then 0
					else 1
				end as isResource,
			
				pj3.projectUUID as containerID,
				pj3.projectName as containerName,
				pj2.projectUUID as serviceID,
				pj2.projectName as serviceName,
				pj1.projectUUID as resourceID,
				pj1.projectName as resourceName,
				pj1.nodeType
				
			from silkProject pj1
			join silkNode pn on pj1.nodeType = pn.nodeType
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pn.import=1
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-files" silkDatabaseID="1" >
		<![CDATA[
			select
				pj1.silkProjectID,
				replace(
					'/'+
					case
						when pj1.projectLevel=3
						then pj3.projectUUID
						else pj4.projectUUID+'/'+pj3.projectName
					end+'/'+
					case
						when pj1.nodeType='ORM' or pj1.nodeType='ORMF'
						then ''
						else pj2.projectName+'/'
					end,
					'//',
					'/'
				) as filePath,
				pj1.projectName+pn.extension as fileName,
				
				case
					when pj1.projectLevel=3
					then pj3.silkProjectID
					else pj4.silkProjectID
				end as cleanID,
				case
					when pj1.projectLevel=3
					then pj3.projectUUID
					else pj4.projectUUID
				end as cleanUUID,
			
				case
					when pj1.nodeType='MOD' or pj1.nodeType='ORMF'
					then 0
					else 1
				end as isResource,
			
				pj3.projectUUID as containerID,
				pj3.projectName as containerName,
				pj2.projectUUID as serviceID,
				pj2.projectName as serviceName,
				pj1.projectUUID as resourceID,
				pj1.projectName as resourceName,
				pj1.nodeType
				
			from dbo.silkProject pj1
			join dbo.silkNode pn on pj1.nodeType = pn.nodeType
			join dbo.silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join dbo.silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join dbo.silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = 1
			and pn.import=1
			and pj1.status=0
			and pj1.silkSystemID = $P{silkSystemID}
			and $P{silkProjectID} in (0,pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-files" silkDatabaseID="3" >
		<![CDATA[
			select
				pj1.silkProjectID,
				replace(
					concat(
						'/',
						case
							when pj1.projectLevel=3
							then pj3.projectUUID
							else concat(pj4.projectUUID,'/',pj3.projectName)
						end,'/',
						case
							when pj1.nodeType='ORM' or pj1.nodeType='ORMF'
							then ''
							else concat(pj2.projectName,'/')
						end
					),
					'//',
					'/'
				) as filePath,
				concat(pj1.projectName,pn.extension) as fileName,
				
				case
					when pj1.projectLevel=3
					then pj3.silkProjectID
					else pj4.silkProjectID
				end as cleanID,
				case
					when pj1.projectLevel=3
					then pj3.projectUUID
					else pj4.projectUUID
				end as cleanUUID,
			
				case
					when pj1.nodeType='MOD' or pj1.nodeType='ORMF'
					then 0
					else 1
				end as isResource,
			
				pj3.projectUUID as containerID,
				pj3.projectName as containerName,
				pj2.projectUUID as serviceID,
				pj2.projectName as serviceName,
				pj1.projectUUID as resourceID,
				pj1.projectName as resourceName,
				pj1.nodeType
				
			from silkProject pj1
			join silkNode pn on pj1.nodeType = pn.nodeType
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pn.import=1
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-files" silkDatabaseID="4" >
		<![CDATA[
			select
				pj1.silkProjectID,
				replace(
					'/'||
					case
						when pj1.projectLevel=3
						then pj3.projectUUID
						else pj4.projectUUID||'/'||pj3.projectName
					end||'/'||
					case
						when pj1.nodeType='ORM' or pj1.nodeType='ORMF'
						then ''
						else pj2.projectName||'/'
					end,
					'//',
					'/'
				) as filePath,
				pj1.projectName||pn.extension as fileName,
				
				case
					when pj1.projectLevel=3
					then pj3.silkProjectID
					else pj4.silkProjectID
				end as cleanID,
				case
					when pj1.projectLevel=3
					then pj3.projectUUID
					else pj4.projectUUID
				end as cleanUUID,
			
				case
					when pj1.nodeType='MOD' or pj1.nodeType='ORMF'
					then 0
					else 1
				end as isResource,
			
				pj3.projectUUID as containerID,
				pj3.projectName as containerName,
				pj2.projectUUID as serviceID,
				pj2.projectName as serviceName,
				pj1.projectUUID as resourceID,
				pj1.projectName as resourceName,
				pj1.nodeType
				
			from silkProject pj1
			join silkNode pn on pj1.nodeType = pn.nodeType
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pn.import=1
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-email" silkDatabaseID="2" >
		<![CDATA[
			select
				pj1.silkProjectID,
				ml.emailUUID,
				ml.langID,
				ml.wrapper,
				ml.sentFrom,
				ml.replyTo,
				ml.copyTo,
				ml.blindTo,
				ml.subject,
				ml.message,
				ml.indexValue
			from silkEmail ml
			join silkProject pj1 on ml.emailUUID = pj1.projectUUID
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pj1.nodeType = 'EMAIL' 
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-email" silkDatabaseID="1" >
		<![CDATA[
			select
				pj1.silkProjectID,
				ml.emailUUID,
				ml.langID,
				ml.wrapper,
				ml.sentFrom,
				ml.replyTo,
				ml.copyTo,
				ml.blindTo,
				ml.subject,
				ml.message,
				ml.indexValue
			from silkEmail ml
			join silkProject pj1 on ml.emailUUID = pj1.projectUUID
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pj1.nodeType = 'EMAIL' 
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-email" silkDatabaseID="3" >
		<![CDATA[
			select
				pj1.silkProjectID,
				ml.emailUUID,
				ml.langID,
				ml.wrapper,
				ml.sentFrom,
				ml.replyTo,
				ml.copyTo,
				ml.blindTo,
				ml.subject,
				ml.message,
				ml.indexValue
			from silkEmail ml
			join silkProject pj1 on ml.emailUUID = pj1.projectUUID
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pj1.nodeType = 'EMAIL' 
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

	<sqlSelect name="sync-email" silkDatabaseID="4" >
		<![CDATA[
			select
				pj1.silkProjectID,
				ml.emailUUID,
				ml.langID,
				ml.wrapper,
				ml.sentFrom,
				ml.replyTo,
				ml.copyTo,
				ml.blindTo,
				ml.subject,
				ml.message,
				ml.indexValue
			from silkEmail ml
			join silkProject pj1 on ml.emailUUID = pj1.projectUUID
			join silkProject pj2 on pj1.parentID = pj2.silkProjectID
			join silkProject pj3 on pj2.parentID = pj3.silkProjectID
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
			where pj1.silkSystemID = $P{silkSystemID}
			and pj1.nodeType = 'EMAIL' 
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
		]]>
	</sqlSelect>

