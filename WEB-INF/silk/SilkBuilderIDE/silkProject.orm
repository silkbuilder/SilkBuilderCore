<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE ormObject>
<orm >

	<table name="silkProject" >
		<column name="silkProjectID" type="I" pk="1" />
		<column name="projectUUID" type="U" />
		<column name="silkSystemID" type="I" secure="1" />
		<column name="parentID" type="I" secure="1" parent="1" />
		<column name="projectLevel" type="I" level="1" />
		<column name="projectName" type="S" />
		<column name="nodeType" type="S" />
		<column name="content" type="S" />
		<column name="lastSyncID" type="I" secure="1" />
		<column name="status" type="I" opStatus="1" />
		<column name="operationAction" type="S" opAction="1" />
		<column name="operationDate" type="D" opDate="1" />
		<column name="operationUser" type="I" secure="1" opUser="1" />
		<column name="silkDeveloperID" type="I" secure="1" />
		<column name="role" type="S" />
		<column name="projectID" type="I" secure="1" />
		<column name="silkDevID" type="I" secure="1" />
	</table>

	<schema silkDatabaseID="2" />
	<schema silkDatabaseID="1" />
	<schema silkDatabaseID="3" />
	<schema silkDatabaseID="4" />

	<sqlSelect name="projectList" silkDatabaseID="2" >
		<![CDATA[
			select
				pj.silkProjectID,
				pj.silkProjectID as pathID,
				pj.projectUUID,
				pj.silkSystemID,
				pj.parentID,
				pj.projectLevel,
				pj.projectName,
				pj.nodeType,
				pn.editor,
				pn.parent,
				pn.iconName,
				pn.iconColor,
				pn.recordOrder,
				pj.lastSyncID,
				pn.sync,
				0 as editRights
			from silkProject pj
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.projectLevel=0
			and pj.status=0
			union
			select
				pj.silkProjectID,
				pj.silkProjectID as pathID,
				pj.projectUUID,
				pj.silkSystemID,
				pj.parentID,
				pj.projectLevel,
				pj.projectName,
				pj.nodeType,
				pn.editor,
				pn.parent,
				pn.iconName,
				pn.iconColor,
				pn.recordOrder,
				pj.lastSyncID,
				pn.sync,
				case
					when $P{role}='admin' then 1
					when $P{role}='architect' then 1
					when $P{role}='developer' and pj.nodeType in ('APP','PUB','CSF','CSFP','MOD','EMAIL') then 1
					else 0
				end as editRights
			from silkProject pj
			join silkNode pn on pj.nodeType=pn.nodeType
			where pj.silkSystemID = $P{silkSystemID}
			and pj.projectLevel>0
			and pj.status=0
			order by projectLevel,parentID, recordOrder, projectName
		]]>
	</sqlSelect>

