	<sqlSelect name="projectRight" silkDatabaseID="2" >
		<![CDATA[
			select
				case
					when editRights like concat('%',pr.nodeType,'%') then 1
					when readOnly like concat('%',pr.nodeType,'%') then 0
					else -1
				end as rights,
				pr.nodeType,
				pr.silkSystemID
			from silkDevRole rl
			join silkProject pr on pr.silkProjectID = $P{silkProjectID}
			where $P{roleList} like concat('%,',rl.silkDevRoleID,',%')
		]]>
	</sqlSelect>

	<sqlSelect name="projectRight" silkDatabaseID="1" >
		<![CDATA[
			select
				case
					when editRights like '%'+pr.nodeType+'%' then 1
					when readOnly like '%'+pr.nodeType+'%' then 0
					else -1
				end as rights,
				pr.nodeType,
				pr.silkSystemID
			from silkDevRole rl
			join silkProject pr on pr.silkProjectID = $P{silkProjectID}
			where $P{roleList} like '%,'+convert(varchar,rl.silkDevRoleID)+',%'
		]]>
	</sqlSelect>

