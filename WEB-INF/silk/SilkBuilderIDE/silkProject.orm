	<sqlSelect name="getProject" silkDatabaseID="2" >
		<![CDATA[
			select
				pj1.projectUUID as containerID,
				sy.theme,
				sy.silkSystemUUID,
				sy.testdb,
				sy.testdb1,
				sy.testdb2,
				sy.testdb3,
				sy.testdb4,
				ts.silkUserID,
				ts.variableList,
				ts.roleList
			from silkProject pj1
			join silkSystem sy on pj1.silkSystemID = sy.silkSystemID
			left join silkTesting ts on sy.silkSystemID = ts.silkSystemID
				and ts.silkDeveloperID = $P{silkDeveloperID,0}
				and ts.position = 0
			where case
					when length($P{containerName,''})=36
					then pj1.projectUUID
					else replace(pj1.projectName,' ','')
				end = $P{containerName,''}
			and pj1.silkSystemID = $P{silkSystemID}
			and pj1.projectLevel = 1
		]]>
	</sqlSelect>

