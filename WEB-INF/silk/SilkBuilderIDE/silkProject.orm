	<sqlOperation silkDatabaseID="2" name="updateContent" >
		<![CDATA[
			update silkProject set
				content = $P{content},
				operationAction = 'update',
				operationDate = CURRENT_TIMESTAMP,
				operationUser = $P{silkDevID}
			where silkProjectID = $P{silkProjectID}
			and status=0
		]]>
	</sqlOperation>

	<sqlOperation silkDatabaseID="1" name="updateContent" >
		<![CDATA[
			update silkProject set
				content = $P{content},
				operationAction = 'update',
				operationDate = getDate(),
				operationUser = $P{silkDevID}
			where silkProjectID = $P{silkProjectID}
			and status=0
		]]>
	</sqlOperation>

