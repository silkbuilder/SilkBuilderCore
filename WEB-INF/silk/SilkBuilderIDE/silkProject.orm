	<sqlSelect name="projectExport" silkDatabaseID="2" >
		<![CDATA[
			select
				pj1.silkProjectID as exportProjectID,
				pj1.projectUUID,
				pj1.silkSystemID as exportSystemID,
				pj1.parentID as exportParentID,
				pj1.projectLevel,
				pj1.projectName,
				pj1.nodeType,
				pj1.content,
				pj1.lastSyncID,
				pj1.status
			from silkProject pj1
			left join silkNode pn on pj1.nodeType = pn.nodeType
			left join silkProject pj2 on pj1.parentID = pj2.silkProjectID
				and pj2.status=0
			left join silkProject pj3 on pj2.parentID = pj3.silkProjectID
				and pj3.status=0
			left join silkProject pj4 on pj3.parentID = pj4.silkProjectID
				and pj4.status=0
			where pj1.silkSystemID = $P{silkSystemID}
			and pj1.status=0
			and $P{silkProjectID} in (0, pj4.silkProjectID, pj3.silkProjectID, pj2.silkProjectID, pj1.silkProjectID)
			order by projectLevel
		]]>
	</sqlSelect>

